{
  "swagger": "2.0",
  "info": {
    "title": "google/api/http.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "InventoryService",
      "description": "InventoryService управляет каталогом деталей для космических кораблей"
    },
    {
      "name": "PaymentService",
      "description": "PaymentService обрабатывает оплату заказов"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/payment/order/{order_uuid}": {
      "post": {
        "summary": "PayOrder обрабатывает оплату заказа",
        "operationId": "PaymentService_PayOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PayOrderResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "order_uuid",
            "description": "UUID заказа",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PaymentServicePayOrderBody"
            }
          }
        ],
        "tags": [
          "PaymentService"
        ]
      }
    },
    "/inventory.v1.InventoryService/GetPart": {
      "post": {
        "summary": "GetPart возвращает деталь по UUID",
        "operationId": "InventoryService_GetPart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetPartResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1GetPartRequest"
            }
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/inventory.v1.InventoryService/ListParts": {
      "post": {
        "summary": "ListParts возвращает список деталей с опциональной фильтрацией",
        "operationId": "InventoryService_ListParts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPartsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ListPartsRequest"
            }
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/inventory.v1.InventoryService/ReleaseParts": {
      "post": {
        "summary": "ReleaseParts освобождает ранее зарезервированные детали",
        "operationId": "InventoryService_ReleaseParts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ReleasePartsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ReleasePartsRequest"
            }
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/inventory.v1.InventoryService/ReserveParts": {
      "post": {
        "summary": "ReserveParts резервирует детали для заказа",
        "operationId": "InventoryService_ReserveParts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ReservePartsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ReservePartsRequest"
            }
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    },
    "/inventory.v1.InventoryService/ValidateCompatibility": {
      "post": {
        "summary": "ValidateCompatibility проверяет совместимость деталей между собой",
        "operationId": "InventoryService_ValidateCompatibility",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ValidateCompatibilityResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ValidateCompatibilityRequest"
            }
          }
        ],
        "tags": [
          "InventoryService"
        ]
      }
    }
  },
  "definitions": {
    "PaymentServicePayOrderBody": {
      "type": "object",
      "title": "Запрос на оплату заказа"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1GetPartRequest": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "title": "UUID детали"
        }
      },
      "title": "Запрос на получение детали по UUID"
    },
    "v1GetPartResponse": {
      "type": "object",
      "properties": {
        "part": {
          "$ref": "#/definitions/v1Part",
          "title": "Найденная деталь"
        }
      },
      "title": "Ответ с деталью"
    },
    "v1ListPartsRequest": {
      "type": "object",
      "properties": {
        "part_type": {
          "$ref": "#/definitions/v1PartType",
          "title": "Фильтр по типу детали"
        },
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Фильтр по UUID"
        }
      },
      "title": "Запрос на получение списка деталей"
    },
    "v1ListPartsResponse": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Part"
          },
          "title": "Список деталей"
        }
      },
      "title": "Ответ со списком деталей"
    },
    "v1Part": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "title": "Уникальный идентификатор детали"
        },
        "name": {
          "type": "string",
          "title": "Название детали"
        },
        "description": {
          "type": "string",
          "title": "Описание детали"
        },
        "price": {
          "type": "string",
          "format": "int64",
          "title": "Цена в копейках (5000₽ = 500000)"
        },
        "part_type": {
          "$ref": "#/definitions/v1PartType",
          "title": "Тип детали"
        },
        "stock_quantity": {
          "type": "string",
          "format": "int64",
          "title": "Количество на складе"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Дата создания"
        }
      },
      "title": "Part представляет деталь космического корабля"
    },
    "v1PartType": {
      "type": "string",
      "enum": [
        "PART_TYPE_UNSPECIFIED",
        "PART_TYPE_HULL",
        "PART_TYPE_ENGINE",
        "PART_TYPE_SHIELD",
        "PART_TYPE_WEAPON"
      ],
      "default": "PART_TYPE_UNSPECIFIED",
      "description": "- PART_TYPE_UNSPECIFIED: Не указан\n - PART_TYPE_HULL: Корпус\n - PART_TYPE_ENGINE: Двигатель\n - PART_TYPE_SHIELD: Щит\n - PART_TYPE_WEAPON: Оружие",
      "title": "Тип детали"
    },
    "v1PayOrderResponse": {
      "type": "object",
      "properties": {
        "transaction_uuid": {
          "type": "string",
          "title": "UUID транзакции оплаты"
        }
      }
    },
    "v1ReleasePartsRequest": {
      "type": "object",
      "properties": {
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "UUID деталей для освобождения"
        }
      },
      "title": "Запрос на освобождение ранее зарезервированных деталей"
    },
    "v1ReleasePartsResponse": {
      "type": "object",
      "title": "Ответ на освобождение (пустой — значит успешно)"
    },
    "v1ReservePartsRequest": {
      "type": "object",
      "properties": {
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "UUID деталей для резервирования"
        }
      },
      "title": "Запрос на резервирование деталей"
    },
    "v1ReservePartsResponse": {
      "type": "object",
      "title": "Ответ на резервирование (пустой — значит успешно)"
    },
    "v1ValidateCompatibilityRequest": {
      "type": "object",
      "properties": {
        "hull_uuid": {
          "type": "string",
          "title": "UUID детали в слоте корпуса (обязательный слот)"
        },
        "engine_uuid": {
          "type": "string",
          "title": "UUID детали в слоте двигателя (обязательный слот)"
        },
        "shield_uuid": {
          "type": "string",
          "title": "UUID детали в слоте щита (опциональный слот, пустая строка — слот не используется)"
        },
        "weapon_uuid": {
          "type": "string",
          "title": "UUID детали в слоте оружия (опциональный слот, пустая строка — слот не используется)"
        }
      },
      "title": "Запрос на проверку совместимости деталей по слотам корабля"
    },
    "v1ValidateCompatibilityResponse": {
      "type": "object",
      "title": "Ответ на проверку совместимости (пустой — значит совместимы)"
    }
  }
}
